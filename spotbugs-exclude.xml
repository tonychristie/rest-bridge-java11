<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Spring injects the beans -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.controller.ObjectController"/>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.service.DqlService"/>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.service.ObjectService"/>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.service.SessionService"/>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.service.TypeService"/>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.spire.restbridge.service.UserGroupService"/>
        <Method name="&lt;init&gt;"/>
    </Match>

    <!-- The names are part of the JSON contract -->
    <Match>
        <Bug pattern="NM_CONFUSING"/>
        <Class name="com.spire.restbridge.dto.ConnectRequest"/>
        <Method name="getUsername"/>
    </Match>
    <Match>
        <Bug pattern="NM_CONFUSING"/>
        <Class name="com.spire.restbridge.dto.ConnectRequest"/>
        <Method name="setUsername"/>
    </Match>
</FindBugsFilter>
